{
	"compilerOptions": {
		"target": "es2025",
		"module": "nodenext",
		"strict": true,
		"sourceMap": false,
		"declaration": true,
		"moduleResolution": "nodenext",
		"erasableSyntaxOnly": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"outDir": "dist",
		"rootDir": "src",
		"paths": {
			"@/*": ["./src/*"]
		},
		"lib": ["ES2022"]
	},
	"include": ["src/**/*.ts"],
	"exclude": []
}
